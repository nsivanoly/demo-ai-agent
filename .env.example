# Injected by Agent Manager for a platform-hosted agent -- never set by hand.
# Listed here so the contract is visible when running the agent locally.
AMP_AGENTID_CLIENT_ID=
AMP_AGENTID_CLIENT_SECRET=
AMP_AGENTID_TOKEN_ENDPOINT=http://default-idp.amp.localhost:8080/oauth2/token
AMP_AGENTID_SCOPES=
# The gateway URL for the bound MCP proxy. AMP injects it as
# <CONFIG>_MCP_CONFIG_URL; this is the fallback the demo setup writes.
MCP_GATEWAY_URL=http://default-default.gateway.localhost:19080/default/commerce-gw/mcp

# Written by the demo setup after roles are assigned
AGENT_NAME=demo2-concierge-agent
AGENT_RUNTIME=runtime-a
AGENT_SCOPES=commerce-gw:read-order commerce-gw:read-customer commerce-gw:audit-read
OBO_SIGNING_KEY=
USER_TOKEN_ISSUER=http://thunder.amp.localhost:8080
PAYMENTS_AGENT_URL=
PAYMENTS_AGENT_INTERNAL_URL=http://demo2-payments-agent:8000
LOW_TOOL=get_order
CONFIDENTIAL_TOOL=charge_card
CONFIDENTIAL_SCOPE=commerce-gw:charge-payment

# Set to false only when driving the agent by hand without a user token.
REQUIRE_USER_TOKEN=true
AGENT_PORT=8000
