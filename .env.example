# Injected automatically by WSO2 Agent Manager for a platform-hosted agent.
# Set them by hand only when running the agent locally against AMP.
AMP_AGENTID_CLIENT_ID=
AMP_AGENTID_CLIENT_SECRET=
AMP_AGENTID_TOKEN_ENDPOINT=http://default-idp.amp.localhost:8080/oauth2/token
AMP_AGENTID_SCOPES=

# Where this agent sends its tool calls, and the resource its token is bound to
MCP_URL=http://host.k3d.internal:8892/mcp
MCP_RESOURCE=http://default-default.gateway.localhost:19080/mcp
