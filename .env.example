# Injected by Agent Manager for a platform-hosted agent -- never set by hand.
AMP_AGENTID_CLIENT_ID=
AMP_AGENTID_CLIENT_SECRET=
AMP_AGENTID_TOKEN_ENDPOINT=http://default-idp.amp.localhost:8080/oauth2/token
AMP_AGENTID_SCOPES=
MCP_GATEWAY_URL=http://default-default.gateway.localhost:19080/default/commerce-gw/mcp

# Written by the demo setup after roles are assigned
AGENT_NAME=demo2-payments-agent
AGENT_RUNTIME=runtime-b
AGENT_SCOPES=commerce-gw:charge-payment commerce-gw:read-customer commerce-gw:audit-read
OBO_SIGNING_KEY=
CONFIDENTIAL_TOOL=charge_card

# Agents whose on-behalf-of assertions this one accepts.
TRUSTED_DELEGATORS=demo2-concierge-agent
AGENT_PORT=8000
